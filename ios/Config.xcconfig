// JL Physical Configuration
// Copy this file and customize for your build

// REQUIRED: Set these values before building
PRODUCT_BUNDLE_IDENTIFIER = com.jonathanbowe.jlphysical
DEVELOPMENT_TEAM = 2UMNXHG36N
APP_DISPLAY_NAME = JL Physical

// App Group for widget/extensions (update to match your bundle ID)
APP_GROUP_IDENTIFIER = group.com.jonathanbowe.jlphysical

// Version and build
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1

// Code signing (for local development, use automatic signing)
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = Apple Development

// For App Store builds, uncomment and set:
// CODE_SIGN_STYLE = Manual
// PROVISIONING_PROFILE_SPECIFIER = YourProfileName
